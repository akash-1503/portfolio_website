generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum Role {
  SUPER_ADMIN
  ADMIN
  VOLUNTEER
  USER
}

enum GalleryType {
  IMAGE
  VIDEO
  STORY
}

enum NotificationType {
  TASK
  EVENT
  CAMPAIGN
  CERTIFICATE
  ATTENDANCE
  MESSAGE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProgramStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CLOSED
}

enum EventStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DonationMode {
  ONLINE
  OFFLINE
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum CertificateType {
  PROGRAM
  CAMPAIGN
  EVENT
}

enum CertificateStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum ErrorSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

//////////////////////////////////////////////////////////
// NGO
//////////////////////////////////////////////////////////

model NGO {
  id String @id @default(cuid())

  name String

  email String? @unique

  phone String?

  website String?

  address String?

  city String?

  state String?

  country String?

  postalCode String?

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  //////////////////////////////////////////////////////

  users User[]

  programs Program[]

  campaigns Campaign[]

  events Event[]

  donations Donation[]

  galleryPosts GalleryPost[]

  systemErrors SystemError[]

  //////////////////////////////////////////////////////

  @@index([name])
  @@index([city])
  @@index([country])
}

//////////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////////

model User {
  id String @id @default(cuid())

  ngoId String?

  ngo NGO? @relation(fields: [ngoId], references: [id])

  triggeredErrors SystemError[] @relation("TriggeredErrors")

  resolvedErrors SystemError[] @relation("ResolvedErrors")

  name String

  email String @unique

  password String?

  phone String?

  image String?

  role Role @default(USER)

  status UserStatus @default(ACTIVE)

  emailVerified DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  /////////////////////////////////////////////////////

  volunteer Volunteer?

  donations Donation[]

  notifications Notification[]

  /////////////////////////////////////////////////////

  createdPrograms Program[] @relation("ProgramCreator")

  createdCampaigns Campaign[] @relation("CampaignCreator")

  createdEvents Event[] @relation("EventCreator")

  createdGalleryPosts GalleryPost[] @relation("GalleryCreator")

  /////////////////////////////////////////////////////

  sentMessages Message[] @relation("Sender")

  /////////////////////////////////////////////////////

  accounts Account[]

  sessions Session[]

  conversationMembers ConversationMember[]

  eventRegistrations EventRegistration[]

  /////////////////////////////////////////////////////

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([ngoId])
}

//////////////////////////////////////////////////////////
// AUTH.JS
//////////////////////////////////////////////////////////

model Account {
  id String @id @default(cuid())

  userId String

  type String

  provider String

  providerAccountId String

  refresh_token String? @db.Text

  access_token String? @db.Text

  expires_at Int?

  token_type String?

  scope String?

  id_token String? @db.Text

  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String @unique

  userId String

  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String

  token String @unique

  expires DateTime

  @@unique([identifier, token])
}

//////////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////////

model Notification {
  type NotificationType
  id   String           @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

//////////////////////////////////////////////////////////
// VOLUNTEER
//////////////////////////////////////////////////////////

model Volunteer {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio String?

  skills String[]

  availability String?

  emergencyContact String?

  joinedAt DateTime @default(now())

  hoursCompleted Int @default(0)

  attendancePercentage Float @default(0)

  rating Float @default(0)

  certificatesCount Int @default(0)

  assignedPrograms VolunteerProgram[]

  assignedEvents VolunteerEvent[]

  attendances Attendance[]

  certificates Certificate[]
}

//////////////////////////////////////////////////////////
// VOLUNTEER PROGRAM
//////////////////////////////////////////////////////////

model VolunteerProgram {
  id String @id @default(cuid())

  volunteerId String

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  programId String

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  assignedBy String

  assignedAt DateTime @default(now())

  @@unique([volunteerId, programId])
}

//////////////////////////////////////////////////////////
// VOLUNTEER EVENT
//////////////////////////////////////////////////////////

model VolunteerEvent {
  id String @id @default(cuid())

  volunteerId String

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  eventId String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  assignedBy String

  assignedAt DateTime @default(now())

  attendanceMarked Boolean @default(false)

  @@unique([volunteerId, eventId])
}

//////////////////////////////////////////////////////////
// ATTENDANCE
//////////////////////////////////////////////////////////

model Attendance {
  id String @id @default(cuid())

  volunteerId String

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  eventId String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status AttendanceStatus

  checkIn DateTime?

  checkOut DateTime?

  remarks String?

  createdAt DateTime @default(now())

  @@unique([volunteerId, eventId])
}

//////////////////////////////////////////////////////////
// CERTIFICATE
//////////////////////////////////////////////////////////
model Certificate {
  id String @id @default(cuid())

  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  title String

  description String?

  certificateNumber String @unique

  type CertificateType

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  certificateUrl String?

  issuedBy String?

  issuedAt DateTime @default(now())

  status CertificateStatus

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([volunteerId])
  @@index([status])
  @@index([type])
}

//////////////////////////////////////////////////////////
// PROGRAM
//////////////////////////////////////////////////////////

model Program {
  id String @id @default(cuid())

  ngoId String
  ngo   NGO    @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  name String

  category String

  description String? @db.Text

  objective String? @db.Text

  coordinator String?

  manager String?

  budget Decimal @db.Decimal(12, 2)

  usedBudget Decimal @default(0) @db.Decimal(12, 2)

  beneficiaries Int @default(0)

  progress Int @default(0)

  startDate DateTime

  endDate DateTime?

  location String?

  coverImage String?

  status ProgramStatus @default(UPCOMING)

  createdBy String
  creator   User   @relation("ProgramCreator", fields: [createdBy], references: [id])

  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  campaigns    Campaign[]
  events       Event[]
  volunteers   VolunteerProgram[]
  certificates Certificate[]

  @@index([ngoId])
  @@index([status])
}

//////////////////////////////////////////////////////////
// CAMPAIGN
//////////////////////////////////////////////////////////

model Campaign {
  id String @id @default(cuid())

  ngoId String
  ngo   NGO    @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  programId String?

  program Program? @relation(fields: [programId], references: [id])

  title String

  description String? @db.Text

  goalAmount Decimal @db.Decimal(12, 2)

  raisedAmount Decimal @default(0) @db.Decimal(12, 2)

  coverImage String?

  startDate DateTime

  endDate DateTime?

  status CampaignStatus @default(DRAFT)

  createdBy String
  creator   User   @relation("CampaignCreator", fields: [createdBy], references: [id])

  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  donations    Donation[]
  events       Event[]
  galleryPosts GalleryPost[]
  certificates Certificate[]

  @@index([ngoId])
  @@index([status])
}

//////////////////////////////////////////////////////////
// EVENT
//////////////////////////////////////////////////////////

model Event {
  id String @id @default(cuid())

  ngoId String
  ngo   NGO    @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  title String

  category String

  eventType String

  summary String?

  description String? @db.Text

  venue String?

  address String?

  city String?

  state String?

  country String?

  postalCode String?

  googleMapUrl String?

  startDate DateTime

  endDate DateTime?

  registrationDeadline DateTime?

  timezone String?

  maxParticipants Int?

  maxVolunteers Int?

  minVolunteers Int?

  maxGuests Int?

  coverImage String?

  status EventStatus @default(UPCOMING)

  createdBy String
  creator   User   @relation("EventCreator", fields: [createdBy], references: [id])

  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  volunteers         VolunteerEvent[]
  attendance         Attendance[]
  certificates       Certificate[]
  eventRegistrations EventRegistration[]
  galleryPosts       GalleryPost[]

  @@index([ngoId])
  @@index([status])
}

//////////////////////////////////////////////////////////
// GalleryPost
//////////////////////////////////////////////////////////
model GalleryPost {
  id String @id @default(cuid())

  ngoId String
  ngo   NGO    @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  title String

  description String? @db.Text

  type GalleryType

  mediaUrl     String?
  thumbnailUrl String?

  category String?

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(false)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  createdBy String
  creator   User   @relation("GalleryCreator", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedAt DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([ngoId])
  @@index([type])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([createdAt])
}

//////////////////////////////////////////////////////////
// DONATION
//////////////////////////////////////////////////////////

model Donation {
  id String @id @default(cuid())

  ngoId String
  ngo   NGO    @relation(fields: [ngoId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  donorName String

  donorEmail String?

  donorPhone String?

  amount Decimal @db.Decimal(12, 2)

  donationMode DonationMode

  paymentMethod String?

  status DonationStatus

  remarks String?

  ///////////////////////////////////////////////////
  // Razorpay
  ///////////////////////////////////////////////////

  razorpayOrderId String?

  razorpayPaymentId String?

  razorpaySignature String?

  ///////////////////////////////////////////////////

  transactionId String?

  receiptNumber String? @unique

  receiptUrl String?

  donatedByAdmin Boolean @default(false)

  donatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([ngoId])
  @@index([status])
  @@index([donatedAt])
}

//////////////////////////////////////////////////////////
// CONVERSATION
//////////////////////////////////////////////////////////

model Conversation {
  id String @id @default(cuid())

  isGroup Boolean @default(false)

  groupName String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  members ConversationMember[]

  messages Message[]
}

//////////////////////////////////////////////////////////
// CONVERSATION MEMBER
//////////////////////////////////////////////////////////

model ConversationMember {
  id String @id @default(cuid())

  conversationId String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
}

//////////////////////////////////////////////////////////
// EventRegistration
//////////////////////////////////////////////////////////

model EventRegistration {
  id String @id @default(cuid())

  // User who registered for the event
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Event for which the user registered
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Date and time when registration was created
  registeredAt DateTime @default(now())

  // Prevent the same user from registering
  // for the same event more than once
  @@unique([userId, eventId])
  // Useful indexes for API queries
  @@index([userId])
  @@index([eventId])
  @@index([registeredAt])
}

//////////////////////////////////////////////////////////
// MESSAGE
//////////////////////////////////////////////////////////

model Message {
  id String @id @default(cuid())

  conversationId String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String

  sender User @relation("Sender", fields: [senderId], references: [id])

  type MessageType @default(TEXT)

  content String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  attachments Attachment[]
}

//////////////////////////////////////////////////////////
// ATTACHMENT
//////////////////////////////////////////////////////////

model Attachment {
  id String @id @default(cuid())

  messageId String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String

  fileUrl String

  fileType String

  fileSize Int

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////////
// SystemError
//////////////////////////////////////////////////////////
model SystemError {
  id String @id @default(cuid())

  // NGO that the error belongs to
  ngoId String?
  ngo   NGO?    @relation(fields: [ngoId], references: [id])

  // User who triggered the request, if known
  userId String?
  user   User?   @relation("TriggeredErrors", fields: [userId], references: [id])

  // API information
  method     String?
  endpoint   String?
  statusCode Int?

  // Error information
  errorType String?
  message   String
  stack     String?

  // Additional debugging information
  requestId String?
  metadata  Json?

  // Management
  severity ErrorSeverity @default(ERROR)
  resolved Boolean       @default(false)

  resolvedAt DateTime?

  resolvedById String?
  resolvedBy   User?   @relation("ResolvedErrors", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())

  @@index([ngoId])
  @@index([userId])
  @@index([resolvedById])
  @@index([statusCode])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
}
